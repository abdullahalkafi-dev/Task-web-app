<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
  <TextView android:id="@+id/widget_task" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textColor="#111827" />
  <TextView android:id="@+id/widget_complete" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="✓" android:contentDescription="Complete task" android:textColor="#15803D" android:textSize="24sp" />
</LinearLayout>
