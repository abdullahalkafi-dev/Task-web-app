{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts"]
}
