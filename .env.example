APP_PORT=3000
MONGO_URI=mongodb://mongo:27017/dayflow
JWT_SECRET=change_me_to_a_long_random_string
# Google Cloud Console -> Credentials -> OAuth client ID (Web). Public value, no secret needed.
GOOGLE_CLIENT_ID=
# Comma-separated Google emails that become Super Admin when they sign in (not seeded, no password).
SUPERADMIN_EMAILS=
UPLOAD_MAX_MB=10
COOKIE_SECURE=false        # set true when served over HTTPS
TZ=Asia/Dhaka
